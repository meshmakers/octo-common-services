<Project Sdk="Microsoft.NET.Sdk">

    <!-- Handler replica as its own process for the hard-kill measurement (AB#7823). Not a test project, not packable. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>Meshmakers.Octo.Services.Methods.Measurements.Worker</RootNamespace>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Methods.Measurements\MeasurementHandlerHost.cs" Link="MeasurementHandlerHost.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Methods\Methods.csproj" />
        <ProjectReference Include="..\..\src\Observability\Observability.csproj" />
    </ItemGroup>

</Project>
