<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Services.RestDeprecation</AssemblyName>
        <PackageId>Meshmakers.Octo.Services.RestDeprecation</PackageId>
        <RootNamespace>Meshmakers.Octo.Services.RestDeprecation</RootNamespace>
        <Description>Marks REST actions deprecated with one attribute: RFC 9745/8594 headers, OpenAPI flag and a per-client usage counter</Description>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Deliberately free of package dependencies: Swagger (OpenAPI transformer) and Observability (registration) both
         reference this project, and neither may pull the other's dependencies into every consumer. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RestDeprecation.Tests" />
        <!-- The OpenAPI transformer resolves the wave dates through RestDeprecationResolver (AB#8415). -->
        <InternalsVisibleTo Include="Meshmakers.Octo.Services.Swagger" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\meshmakers64.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>meshmakers64.png</Link>
        </None>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>LICENSE</Link>
        </None>
    </ItemGroup>
</Project>
