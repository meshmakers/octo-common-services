<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Services.Observability</AssemblyName>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Meshmakers.Octo.Services.Observability</PackageId>
        <RootNamespace>Meshmakers.Octo.Services.Observability</RootNamespace>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>1701;1702;NU5104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Meshmakers.Octo.Runtime.Engine.MongoDb" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.ResourceUtilization" Version="10.9.0" />
        <!--
            AB#5478 section 2.3: the otel-trace-id / otel-span-id layout renderers. They live in
            Meshmakers.Common.Observability rather than here because three deployed processes
            carry none of the Meshmakers.Octo.Services.* packages — the communication operator
            and the Loxone and SAP adapters — and this package pulls the OpenTelemetry exporters,
            the AspNetCore and Http instrumentation, HealthChecks and the MongoDb runtime engine.
            Referencing it here keeps the renderers in every service's output directory, which is
            what nlog.config's <extensions> element needs.
        -->
        <PackageReference Include="Meshmakers.Common.Observability" Version="$(MeshmakerVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\meshmakers64.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>meshmakers64.png</Link>
        </None>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>LICENSE</Link>
        </None>
    </ItemGroup>
</Project>
