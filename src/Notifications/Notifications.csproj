<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Services.Notifications</AssemblyName>
        <RootNamespace>Meshmakers.Octo.Services.Notifications</RootNamespace>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <OctoPublishCkModel Condition="'$(TargetFramework)' == 'net10.0'">true</OctoPublishCkModel>
        <OctoGenerateCkDocumentation Condition="'$(TargetFramework)' == 'net10.0'">true</OctoGenerateCkDocumentation>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Description>System Construction Kit for Notification and Events</Description>
        <PackageId>Meshmakers.Octo.Services.Notifications</PackageId>
        <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
        <!-- AB#6326: every attribute in ConstructionKit/attributes/*.yaml declares its ownership
             (SeedOwned / TenantOwned / RuntimeState / Secret, or the older isRuntimeState), reviewed
             against the seed ownership audit AB#6317. The CkLintRuntimeStateMarkers task is armed: a new
             attribute without a marker FAILS the build (OCTO-CK001) instead of silently defaulting to
             seed-owned, where the next blueprint update would overwrite a value the tenant entered.
             Review question for every new attribute: could an operator or user type this value in the
             product? -->
        <OctoEnforceRuntimeStateMarkers>true</OctoEnforceRuntimeStateMarkers>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Notifications.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meshmakers.Octo.Runtime.Contracts.MongoDb" Version="$(OctoCoreLibVersion)" />
        <ProjectReference Include="..\Contracts\Contracts.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Markdig" Version="1.3.2" />
        <PackageReference Include="Meshmakers.Octo.Communication.Contracts" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.Models.System" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.SourceGeneration" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Version="$(OctoCoreLibVersion)" PrivateAssets="all" />
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.MsBuildTasks" Version="$(OctoCoreLibVersion)" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ConstructionKitFolder Visible="false" Include="ConstructionKit"/>
        <BlueprintFolder Visible="false" Include="$(MSBuildProjectDirectory)\Blueprints"/>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Assets\materialize.min.css" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\meshmakers64.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>meshmakers64.png</Link>
        </None>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>LICENSE</Link>
        </None>
    </ItemGroup>
</Project>
