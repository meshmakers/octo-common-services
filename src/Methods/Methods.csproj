<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Services.Methods</AssemblyName>
        <PackageId>Meshmakers.Octo.Services.Methods</PackageId>
        <RootNamespace>Meshmakers.Octo.Services.Methods</RootNamespace>
        <Description>CK method handler SDK: typed handlers on top of the OctoMesh CK method wire contract</Description>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
        <DocumentationFile>..\..\bin\$(Configuration)\$(AssemblyName).xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Methods.Tests" />
        <InternalsVisibleTo Include="Methods.IntegrationTests" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
        <!-- AB#7664/AB#7665: the asset repository tests give their in-process test handlers a definition (the host refuses a registration without one) -->
        <InternalsVisibleTo Include="AssetRepositoryServices.UnitTests" />
        <InternalsVisibleTo Include="Meshmakers.Octo.Backend.AssetRepositoryServices.IntegrationTests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\meshmakers64.png">
            <Pack>True</Pack>
            <PackagePath />
            <Link>meshmakers64.png</Link>
        </None>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath />
            <Link>LICENSE</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
        <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Contracts\Contracts.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

</Project>
